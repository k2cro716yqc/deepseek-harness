{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandaloco.invalid/schemas/specialist-owner-receipt-v1.schema.json",
  "title": "Pandaloco specialist owner receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "owner",
    "task_id",
    "attempt_id",
    "runtime_epoch",
    "outcome",
    "artifact_ref",
    "content_digest_sha256",
    "issued_at",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "specialist-owner-receipt/v1" },
    "receipt_id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9._/-]+$" },
    "owner": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "task_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "runtime_epoch": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["completed", "quality_fail", "abstained", "failed"] },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "content_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "material_ref"],
      "properties": {
        "method": { "enum": ["owner-signature", "owner-store-integrity"] },
        "material_ref": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verification": { "properties": { "method": { "const": "owner-signature" } } } } },
      "then": { "properties": { "verification": { "properties": { "material_ref": { "pattern": "^owner-signature:" } } } } }
    },
    {
      "if": { "properties": { "verification": { "properties": { "method": { "const": "owner-store-integrity" } } } } },
      "then": { "properties": { "verification": { "properties": { "material_ref": { "pattern": "^owner-store:" } } } } }
    }
  ],
  "x-verifier-contract": {
    "authority": "pandaloco-specialist-receipt-verifier",
    "context_inputs": ["current_task_id", "current_attempt_id", "current_runtime_epoch", "allowed_owners", "artifact_bytes", "attempt_start_watermark", "attempt_end_watermark"],
    "required_checks": ["exact-current-tuple", "owner-allowlist", "artifact-bytes-sha256", "verification-material-over-canonical-receipt", "owner-receipt-id-global-reservation", "attempt-window-membership"],
    "replay_rule": "identical retransmission is evidence-only and effect-free; conflicting, cross-attempt, cross-epoch, wrong-owner, stale-window, or already-bound replay is rejected"
  },
  "examples": [
    {
      "schema_version": "specialist-owner-receipt/v1",
      "receipt_id": "receipt_opaque_01",
      "owner": "pandaloco/example-specialist",
      "task_id": "task_opaque_01",
      "attempt_id": "attempt_opaque_01",
      "runtime_epoch": "dsh-epoch-0001",
      "outcome": "completed",
      "artifact_ref": "owner-store:artifact/example-01",
      "content_digest_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "issued_at": "2026-08-15T09:00:00Z",
      "verification": {
        "method": "owner-store-integrity",
        "material_ref": "owner-store:integrity/example-01"
      }
    }
  ],
  "x-invalid-examples": [
    {
      "reason": "owner is required",
      "value": {
        "schema_version": "specialist-owner-receipt/v1",
        "receipt_id": "receipt_opaque_01",
        "task_id": "task_opaque_01",
        "attempt_id": "attempt_opaque_01",
        "runtime_epoch": "dsh-epoch-0001",
        "outcome": "completed",
        "artifact_ref": "owner-store:artifact/example-01",
        "content_digest_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "issued_at": "2026-08-15T09:00:00Z",
        "verification": { "method": "owner-store-integrity", "material_ref": "owner-store:integrity/example-01" }
      }
    },
    {
      "reason": "outcome is a closed enum",
      "value": {
        "schema_version": "specialist-owner-receipt/v1",
        "receipt_id": "receipt_opaque_01",
        "owner": "pandaloco/example-specialist",
        "task_id": "task_opaque_01",
        "attempt_id": "attempt_opaque_01",
        "runtime_epoch": "dsh-epoch-0001",
        "outcome": "success",
        "artifact_ref": "owner-store:artifact/example-01",
        "content_digest_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "issued_at": "2026-08-15T09:00:00Z",
        "verification": { "method": "owner-store-integrity", "material_ref": "owner-store:integrity/example-01" }
      }
    },
    {
      "reason": "content digest must be lowercase SHA-256",
      "value": {
        "schema_version": "specialist-owner-receipt/v1",
        "receipt_id": "receipt_opaque_01",
        "owner": "pandaloco/example-specialist",
        "task_id": "task_opaque_01",
        "attempt_id": "attempt_opaque_01",
        "runtime_epoch": "dsh-epoch-0001",
        "outcome": "completed",
        "artifact_ref": "owner-store:artifact/example-01",
        "content_digest_sha256": "not-a-digest",
        "issued_at": "2026-08-15T09:00:00Z",
        "verification": { "method": "owner-store-integrity", "material_ref": "owner-store:integrity/example-01" }
      }
    },
    {
      "reason": "verification method and material reference must agree",
      "value": {
        "schema_version": "specialist-owner-receipt/v1",
        "receipt_id": "receipt_opaque_01",
        "owner": "pandaloco/example-specialist",
        "task_id": "task_opaque_01",
        "attempt_id": "attempt_opaque_01",
        "runtime_epoch": "dsh-epoch-0001",
        "outcome": "completed",
        "artifact_ref": "owner-store:artifact/example-01",
        "content_digest_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "issued_at": "2026-08-15T09:00:00Z",
        "verification": { "method": "owner-signature", "material_ref": "owner-store:integrity/example-01" }
      }
    },
    {
      "reason": "model text cannot be a verification method",
      "value": {
        "schema_version": "specialist-owner-receipt/v1",
        "receipt_id": "receipt_opaque_01",
        "owner": "pandaloco/example-specialist",
        "task_id": "task_opaque_01",
        "attempt_id": "attempt_opaque_01",
        "runtime_epoch": "dsh-epoch-0001",
        "outcome": "completed",
        "artifact_ref": "transcript:model-claim",
        "content_digest_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "issued_at": "2026-08-15T09:00:00Z",
        "verification": { "method": "model-claim", "material_ref": "transcript:1" }
      }
    }
  ],
  "x-context-invalid-examples": [
    { "reason": "wrong task", "receipt_patch": { "task_id": "task_other" } },
    { "reason": "wrong attempt", "receipt_patch": { "attempt_id": "attempt_other" } },
    { "reason": "wrong epoch", "receipt_patch": { "runtime_epoch": "dsh-epoch-other" } },
    { "reason": "owner not in current allowlist", "receipt_patch": { "owner": "pandaloco/other-specialist" } },
    { "reason": "artifact bytes do not match digest", "artifact_bytes_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" },
    { "reason": "receipt id already bound to another attempt", "reserved_receipt_id": "receipt_opaque_01" },
    { "reason": "receipt is outside the sealed attempt watermark window", "owner_store_position": "outside-current-window" }
  ]
}
